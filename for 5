#define _CRT_SECURE_NO_WARNINGS
#include <iostream>
#include<string>
using namespace std;

enum {
    A,
    B,
};
class Magazin {
private:

    string denumireMagazin;
    int nrAngajati;
    float suprafataMagazinMP;
    bool esteNonstop;
    const int CUI;
    static int clasaCAENPrincipala;

    char* numeProprietar;
    int nrProduse;
    float* preturiProduse;
    string* denumiriProduse;

public:

    //ctr without param
    Magazin() :CUI(10) {
        this->denumireMagazin = "Anonima";
        this->nrAngajati = 0;
        this->suprafataMagazinMP = 0;
        this->esteNonstop = 1;

        //pt char*
        this->numeProprietar = nullptr;
        this->nrProduse = 0;
        this->preturiProduse = nullptr; //NULL inseamna ca am 0 elemente in vector
        this->denumiriProduse = nullptr;
    }
    //ctr cu parametrii 
    Magazin(string denumireMagazin, int nrAngajati, float suprafataMagazinMP, bool esteNonstop, const int CUI, const char* numeProprietar, int nrProduse, float* preturiProduse, string* denumiriProduse) :CUI(CUI) {
        this->denumireMagazin = denumireMagazin;
        this->nrAngajati = nrAngajati;
        this->suprafataMagazinMP = suprafataMagazinMP;
        this->esteNonstop = esteNonstop;

        //ALOCARE DE MEMORIE
        this->numeProprietar = new char[strlen(numeProprietar) + 1];
        //INITIALIZARE
        strcpy(this->numeProprietar, numeProprietar);

        this->nrProduse = nrProduse;
        //ALOCARE DE MEMORIE

        this->preturiProduse = new float[this->nrProduse];
        this->denumiriProduse = new string[this->nrProduse];

        //INITIALIZARE
        for (int i = 0; i < this->nrProduse; i++) {
            this->preturiProduse[i] = preturiProduse[i];
            this->denumiriProduse[i] = denumiriProduse[i];
        }
    }
    //getters and setters
    //getters
    string getDenumireMagazin()
    {
        return this->denumireMagazin;
    }

    int getNrAngajati()
    {
        return this->nrAngajati;
    }

    float getSuprafataMagazinMP()
    {
        return this->suprafataMagazinMP;
    }

    bool getesteNonstop()
    {
        return this->esteNonstop;
    }

    int getCUI()
    {
        return this->CUI;
    }

    char* getNumeProprietar()
    {
        return this->numeProprietar;
    }

    int getNrProduse()
    {
        return this->nrProduse;
    }

    float* getPreturiProduse()
    {
        return this->preturiProduse;
    }

    string* getDenumiriProduse()
    {
        return this->denumiriProduse;
    }

    //setters
    void setDenumireMagazin(string denumireMagazinNoua)
    {
        if (denumireMagazinNoua.length() >= 2)
        {
            this->denumireMagazin = denumireMagazinNoua;
        }
        else
        {
            this->denumireMagazin = "EROARE!";
        }
    }

    void setNrAngajati(int nrAngajatNou)
    {
        this->nrAngajati = nrAngajatNou;
    }

    void setSuprafataMagazinMP(float suprafataMagazinMPNoua)
    {
        this->suprafataMagazinMP = suprafataMagazinMPNoua;
    }

    void setEsteNonstop(bool esteNonstopN)
    {
        this->esteNonstop = esteNonstopN;
    }

    //SETTERII PENTRU POINTERI presupun dezalocare de memorie (vechea valoare trebuie stearsa cu DELETE) + realocare de memorie + initializarea cu noua valoare primita ca parametru

    void setNumeProprietar(const char* numeProprietar)
    {
            if (numeProprietar == nullptr || numeProprietar == "")
                throw exception("invalid argument");
            delete[] this->numeProprietar;
            this->numeProprietar = new char[strlen(numeProprietar) + 1];
            strcpy_s(this->numeProprietar, strlen(numeProprietar) + 1, numeProprietar);

    }

    //Pt. toti vectorii care vin la pachet cu un numarator, nu am voie sa fac setter separat pentru numarator si setter separat pentru vector (se modifica concomitent, nu individual)

    void setProduse(int nrProduseNou, float* preturiNoiProduse, string* denumiriNoiProduse)
    {
        // Free old memory if exists
        if (this->preturiProduse != nullptr) {
            delete[] this->preturiProduse;
        }
        if (this->denumiriProduse != nullptr) {
            delete[] this->denumiriProduse;
        }

        // Update number of products
        this->nrProduse = nrProduseNou;

        if (this->nrProduse > 0 && preturiNoiProduse != nullptr && denumiriNoiProduse != nullptr) {
            this->preturiProduse = new float[this->nrProduse];
            this->denumiriProduse = new string[this->nrProduse];

            for (int i = 0; i < this->nrProduse; i++) {
                this->preturiProduse[i] = preturiNoiProduse[i];
                this->denumiriProduse[i] = denumiriNoiProduse[i];
            }
        }
        else {
            // If no products or input pointers are null, set to nullptr
            this->preturiProduse = nullptr;
            this->denumiriProduse = nullptr;
        }
    }

    ~Magazin()
    {
        //daca in clasa nu avem pointeri, desctructorul nu o sa contina deloc instructiuni (va fi gol, dar tot trebuie sa existe in continuare)

        if (this->numeProprietar != NULL)
        {
            delete[] this->numeProprietar;
        }
        if (this->preturiProduse != NULL)
        {
            delete[] this->preturiProduse;
        }
        if (this->denumiriProduse != NULL)
        {
            delete[] this->denumiriProduse;
        }

        cout << "S-a apelat destructorul!" << endl;
    }
    Magazin(const Magazin& obj) : CUI(obj.CUI)
    {
        this->denumireMagazin = obj.denumireMagazin;
        this->nrAngajati = obj.nrAngajati;
        this->suprafataMagazinMP = obj.suprafataMagazinMP;
        this->esteNonstop = obj.esteNonstop;

        // Safe copy for numeProprietar
        if (obj.numeProprietar != nullptr) {
            this->numeProprietar = new char[strlen(obj.numeProprietar) + 1];
            strcpy(this->numeProprietar, obj.numeProprietar);
        }
        else {
            this->numeProprietar = nullptr;
        }

        // Safe copy for products
        this->nrProduse = obj.nrProduse;
        if (this->nrProduse > 0 && obj.preturiProduse != nullptr && obj.denumiriProduse != nullptr) {
            this->preturiProduse = new float[this->nrProduse];
            this->denumiriProduse = new string[this->nrProduse];
            for (int i = 0; i < this->nrProduse; ++i) {
                this->preturiProduse[i] = obj.preturiProduse[i];
                this->denumiriProduse[i] = obj.denumiriProduse[i];
            }
        }
        else {
            this->preturiProduse = nullptr;
            this->denumiriProduse = nullptr;
        }
    }
    Magazin& operator=(const Magazin& obj)
    {
        if (this != &obj)
        {
            if (this->numeProprietar != NULL)
            {
                delete[] this->numeProprietar;
            }
            if (this->preturiProduse != NULL)
            {
                delete[] this->preturiProduse;
            }
            if (this->denumiriProduse != NULL)
            {
                delete[] this->denumiriProduse;
            }

            this->denumireMagazin = obj.denumireMagazin;
            this->nrAngajati = obj.nrAngajati;
            this->suprafataMagazinMP = obj.suprafataMagazinMP;
            this->esteNonstop = obj.esteNonstop;

            //1.Alocarea de memorie
            //Functia STRLEN NUMARA cate litere sunt in cuvantul pe care urmeaza sa il punem in char*, iar la final adaugam +1 pentru caracterul \0 (caracterul terminator pus automat de catre compilator la finalul oricarui char*)

            this->numeProprietar = new char[strlen(obj.numeProprietar) + 1];

            //2. Initializarea - functia STRCPY primeste 2 parametri - destinatia + sursa

            strcpy(this->numeProprietar, obj.numeProprietar);

            this->nrProduse = obj.nrProduse;

            //1.Alocarea de memorie - se face cu operatorul NEW, urmat de tipul vectorului, iar intre parantezele patrate trebuie sa specificam nr. de elemente pentru care compilatorul trebuie sa aloce memorie (numaratorul vectorului)
            this->preturiProduse = new float[this->nrProduse];
            this->denumiriProduse = new string[this->nrProduse];

            //2. Initializare
            for (int i = 0; i < this->nrProduse; i++)
            {
                this->preturiProduse[i] = obj.preturiProduse[i];
                this->denumiriProduse[i] = obj.denumiriProduse[i];
            }
        }
        return*this;
    }


    float pretMinim()
    {
        float pretMin;
        pretMin = this->preturiProduse[0];

        for (int i = 1; i < this->nrProduse; i++)
        {
            if (this->preturiProduse[i] < pretMin)
            {
                pretMin = this->preturiProduse[i];
            }
        }

        return pretMin;
    }

    //MIN PRET
    float sumaTotalaPreturi()
    {
        float suma = 0;
        for (int i = 0; i < this->nrProduse; i++)
        {
            suma = suma + this->preturiProduse[i];
        }

        return suma;
    }

    //APLICARE DISCOUNT - reducere la alegere pentru un singur produs din Magazin la alegere
    void aplicareDiscount(float reducere, int pozitieProdusRedus)
    {
        if (pozitieProdusRedus >= 0 && pozitieProdusRedus < this->nrProduse)
        {
            this->preturiProduse[pozitieProdusRedus] = this->preturiProduse[pozitieProdusRedus] - this->preturiProduse[pozitieProdusRedus] * reducere;
        }
        else
        {
            cout << "Pozitie din vector inexistenta!";
        }
    }

    //METODA DE ADAUGARE ELEMENT IN VECTOR - sa se adauge un produs nou in stocul magazinului
    void adaugaProdusNou(float pretProdusNou, string denumireProdusNou)
    {
        Magazin copie(*this);

        if (this->preturiProduse != NULL)
        {
            delete[] this->preturiProduse;
        }
        if (this->denumiriProduse != NULL)
        {
            delete[] this->denumiriProduse;
        }

        this->nrProduse++;
        this->preturiProduse = new float[this->nrProduse];
        this->denumiriProduse = new string[this->nrProduse];

        for (int i = 0; i < copie.nrProduse; i++)
        {
            this->preturiProduse[i] = copie.preturiProduse[i];
            this->denumiriProduse[i] = copie.denumiriProduse[i];
        }

        this->preturiProduse[this->nrProduse - 1] = pretProdusNou;
        this->denumiriProduse[this->nrProduse - 1] = denumireProdusNou;
    }

    //Operatorul <=
    bool operator<=(const Magazin& obj)
    {
        if (this->suprafataMagazinMP >= obj.suprafataMagazinMP)
        {
            return true;
        }
        else
        {
            return false;
        }
    }

