    //Operatorul de indexare []
    //este folosit mereu pe vectori, pt. a returna un singur element din vector in functie de pozitia lui din vector

    string operator[](int pozitieDorita)
    {
        if (pozitieDorita >= 0 && pozitieDorita < this->nrProduse)
        {
            return this->denumiriProduse[pozitieDorita];
        }
        else
        {
            return "Pozitie eronata!";
        }
    }

    //Operatorul functie() - singurul operator care are numar variabil de parametrii (0+)
    //sa se calculeze cate produse din magazin sunt mai scumpe de un anumit prag

    int operator()(float prag)
    {
        int contor = 0;
        for (int i = 0; i < this->nrProduse; i++)
        {
            if (this->preturiProduse[i] > prag)
            {
                contor++;
            }
        }
        return contor;
    }

    //Operatorul logic de negatie - bool, ca un intrerupator
    friend void operator!(Magazin& obj)
    {
        if (obj.esteNonstop == 1)
        {
            obj.esteNonstop = 0;
        }
        else
        {
            obj.esteNonstop = 1;
        }
    }

    //Operatorul de autoincrementare ++
    Magazin& operator++() //PREincrementare
    {
        this->nrAngajati++;
        return*this;
    }

    Magazin operator++(int) //POSTincrementare
    {
        Magazin copie = *this;
        this->nrAngajati++;
        return copie;
    }

    //Operatorul de cast la float - sa se calculeze valoarea totala a TVA-ului pt. toate produsele din magazin
    operator float()
    {
        float TVA = 0.19;
        float sumaTotalaTVA = 0;
        for (int i = 0; i < this->nrProduse; i++)
        {
            sumaTotalaTVA = sumaTotalaTVA + TVA * this->preturiProduse[i];
        }

        return sumaTotalaTVA;
    }

    //Operatorul de cast la string - sa se determine care este denumirea produsului cel mai scump

    operator string()
    {
        float pretMax;
        pretMax = this->preturiProduse[0];
        int contor = 0;

        for (int i = 0; i < this->nrProduse; i++)
        {
            if (this->preturiProduse[i] > pretMax)
            {
                pretMax = this->preturiProduse[i];
                contor = i;
            }
        }

        return this->denumiriProduse[contor];
    }
    // Cast to int: returns 
    explicit operator int()const  {
        return nrAngajati;
    }
    bool comparaPrimaLitera(string* cuvinte, int nrCuvinte) {
        bool existaEgalitati = false;

        for (int i = 0; i < nrCuvinte - 1; i++) {
            for (int j = i + 1; j < nrCuvinte; j++) {
                if (cuvinte[i][0] == cuvinte[j][0]) {
                    cout << "Cuvintele \"" << cuvinte[i]
                        << "\" si \"" << cuvinte[j]
                        << "\" incep cu aceeasi litera: "
                        << cuvinte[i][0] << endl;
                    existaEgalitati = true;
                }
                
            }
        }

        return existaEgalitati;
    }
    // Operator *
    void operator*(float coeficient) {
        for (int i = 0; i < this->nrProduse; i++) {
            this->preturiProduse[i] *= coeficient;
        }
    }

    // Operator <
    bool operator<(const Magazin& other) {
        return this->nrAngajati < other.nrAngajati;
    }
    friend Magazin operator+(int value, const Magazin& obj);
    // Operator +
    Magazin operator+(const Magazin& other) {
        Magazin rezultat(*this);
        rezultat.nrAngajati += other.nrAngajati;

        int totalProduse = this->nrProduse + other.nrProduse;
        float* preturiNoi = new float[totalProduse];
        string* denumiriNoi = new string[totalProduse];

        for (int i = 0; i < this->nrProduse; i++) {
            preturiNoi[i] = this->preturiProduse[i];
            denumiriNoi[i] = this->denumiriProduse[i];
        }

        for (int i = 0; i < other.nrProduse; i++) {
            preturiNoi[i + this->nrProduse] = other.preturiProduse[i];
            denumiriNoi[i + this->nrProduse] = other.denumiriProduse[i];
        }

        rezultat.setProduse(totalProduse, preturiNoi, denumiriNoi);

        delete[] preturiNoi;
        delete[] denumiriNoi;

        return rezultat;
    }

    // Operator -
    Magazin operator-(int scadeAngajati) {
        Magazin copie(*this);
        copie.nrAngajati -= scadeAngajati;
        if (copie.nrAngajati < 0) copie.nrAngajati = 0;
        return copie;
    }

    // Operator ==
    bool operator==(const Magazin& other) {
        return this->CUI == other.CUI && this->denumireMagazin == other.denumireMagazin;
    }

